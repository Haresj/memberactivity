@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Seeker Profile Creation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --bg: #f4f7fb;
      --primary: #2563eb;
      --radius: 14px;
      --shadow: 0 10px 25px rgba(0, 0, 0, .08);
      --text: #0f172a;
      --muted: #64748b;
      --line: #e2e8f0;
    }

    body {
      margin: 0;
      font-family: Inter, "Segoe UI", Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    .page-wrap {
      min-height: 100vh;
      padding: 24px;
    }

    .app-shell {
      max-width: 1350px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 20px;
      align-items: start;
    }

    .card-ui {
      background: #fff;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid rgba(148, 163, 184, .18);
    }

    .sidebar {
      position: sticky;
      top: 20px;
      padding: 18px;
    }

    .brand {
      font-weight: 700;
      font-size: 1.15rem;
      margin-bottom: 16px;
    }

    .tab-btn {
      width: 100%;
      border: 0;
      background: transparent;
      color: #1e293b;
      text-align: left;
      padding: 12px 14px;
      border-radius: 10px;
      font-weight: 600;
      margin-bottom: 6px;
      transition: .2s ease;
    }

    .tab-btn:hover {
      background: #eff6ff;
      color: var(--primary);
    }

    .tab-btn.active {
      background: var(--primary);
      color: white;
      box-shadow: 0 8px 16px rgba(37, 99, 235, .22);
    }

    .content-panel {
      padding: 18px;
      padding-bottom: 110px;
    }

    .section {
      display: none;
      animation: fadeIn .28s ease;
    }

    .section.active {
      display: block;
    }

    @@keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .section-card {
      padding: 20px;
      margin-bottom: 16px;
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .form-label {
      font-weight: 600;
      color: #334155;
      font-size: .9rem;
    }

    .form-control,
    .form-select {
      border-radius: 10px;
      border-color: var(--line);
      padding: .6rem .8rem;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: #93c5fd;
      box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .14);
    }

    .avatar-upload {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 4px solid #dbeafe;
      background: #eff6ff;
      object-fit: cover;
      display: block;
      margin: 4px auto 12px;
    }

    .chip-wrap {
      min-height: 44px;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 8px;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      background: #fff;
    }

    .chip {
      background: #dbeafe;
      color: #1e3a8a;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: .85rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .chip button {
      border: 0;
      background: transparent;
      color: #1e3a8a;
      font-size: 1rem;
      line-height: 1;
      padding: 0;
    }

    .repeat-card {
      border: 1px dashed #bfdbfe;
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 12px;
      background: #f8fbff;
    }

    .sticky-actions {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1050;
      background: rgba(255, 255, 255, .94);
      backdrop-filter: blur(6px);
      border-top: 1px solid #e2e8f0;
      padding: 10px 16px;
    }

    .sticky-actions .inner {
      max-width: 1320px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: flex-end;
    }

    .btn-modern {
      border-radius: 10px;
      font-weight: 600;
      padding: .58rem 1rem;
    }

    @@media (max-width: 992px) {
      .app-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
      }

      .tabs-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .tab-btn {
        margin-bottom: 0;
      }

      .content-panel {
        padding-bottom: 130px;
      }

      .sticky-actions .inner {
        justify-content: center;
      }
    }

    @@media (max-width: 576px) {
      .page-wrap { padding: 12px; }
      .tabs-grid { grid-template-columns: 1fr; }
      .sticky-actions .inner .btn { flex: 1 1 calc(50% - 10px); }
    }
  </style>
</head>
<body>
  <div class="page-wrap">
    <div class="app-shell">
      <aside class="sidebar card-ui">
        <div class="brand">Job Seeker Profile</div>
        <div class="tabs-grid">
          <button class="tab-btn active" onclick="openTab(event,'tab1')">Basic Info</button>
          <button class="tab-btn" onclick="openTab(event,'tab2')">Job Preference</button>
          <button class="tab-btn" onclick="openTab(event,'tab3')">Resume</button>
          <button class="tab-btn" onclick="openTab(event,'tab4')">Skills</button>
          <button class="tab-btn" onclick="openTab(event,'tab5')">Education</button>
          <button class="tab-btn" onclick="openTab(event,'tab6')">Experience</button>
          <button class="tab-btn" onclick="openTab(event,'tab7')">Certificates</button>
          <button class="tab-btn" onclick="openTab(event,'tab8')">Portfolio</button>
        </div>
      </aside>

      <main class="content-panel card-ui">
        <form id="profileForm" novalidate>
          <section class="section active" id="tab1">
            <div class="section-card">
              <h2 class="section-title">Basic Info</h2>
              <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="avatar-upload" id="avatarPreview" alt="Profile Photo" />
              <div class="row g-3">
                <div class="col-md-6"><label class="form-label">First Name *</label><input required type="text" class="form-control" name="first_name"></div>
                <div class="col-md-6"><label class="form-label">Last Name *</label><input required type="text" class="form-control" name="last_name"></div>
                <div class="col-md-6"><label class="form-label">Email *</label><input required type="email" class="form-control" name="email"></div>
                <div class="col-md-6"><label class="form-label">Phone *</label><input required type="tel" class="form-control" name="phone"></div>
                <div class="col-md-4"><label class="form-label">Country *</label><input required type="text" class="form-control" name="country"></div>
                <div class="col-md-4"><label class="form-label">State *</label><input required type="text" class="form-control" name="state"></div>
                <div class="col-md-4"><label class="form-label">City *</label><input required type="text" class="form-control" name="city"></div>
                <div class="col-12"><label class="form-label">Upload Profile Photo</label><input type="file" class="form-control" id="profilePhoto" accept="image/*"></div>
              </div>
            </div>
          </section>

          <section class="section" id="tab2">
            <div class="section-card">
              <h2 class="section-title">Job Preference</h2>
              <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Preferred Role *</label><input required type="text" class="form-control"></div>
                <div class="col-md-6"><label class="form-label">Industry *</label><input required type="text" class="form-control"></div>
                <div class="col-md-4"><label class="form-label">Experience *</label><input required type="text" class="form-control" placeholder="e.g. 4 years"></div>
                <div class="col-md-4"><label class="form-label">Work Mode *</label><select required class="form-select"><option value="">Choose</option><option>Remote</option><option>Hybrid</option><option>Office</option></select></div>
                <div class="col-md-4"><label class="form-label">Expected Salary *</label><input required type="number" class="form-control" placeholder="USD"></div>
                <div class="col-md-6"><label class="form-label">Notice Period *</label><input required type="text" class="form-control" placeholder="e.g. 30 Days"></div>
              </div>
            </div>
          </section>

          <section class="section" id="tab3">
            <div class="section-card">
              <h2 class="section-title">Resume</h2>
              <div class="row g-3">
                <div class="col-12"><label class="form-label">Upload Resume *</label><input required type="file" class="form-control" accept=".pdf,.doc,.docx"></div>
                <div class="col-12"><label class="form-label">Resume Headline *</label><input required type="text" class="form-control" placeholder="Senior Frontend Developer"></div>
                <div class="col-12"><label class="form-label">Professional Summary *</label><textarea required class="form-control" rows="6"></textarea></div>
              </div>
            </div>
          </section>

          <section class="section" id="tab4">
            <div class="section-card">
              <h2 class="section-title">Skills</h2>
              <div class="row g-3">
                <div class="col-md-8"><label class="form-label">Skill Tag Input</label><input type="text" id="skillInput" class="form-control" placeholder="Type a skill and press Enter"></div>
                <div class="col-md-4 d-grid"><label class="form-label d-none d-md-block">&nbsp;</label><button type="button" class="btn btn-primary btn-modern" id="addSkillBtn">Add Skill</button></div>
                <div class="col-12"><label class="form-label">Your Skills *</label><div class="chip-wrap" id="skillsContainer"></div><input type="hidden" id="skillsRequired" required></div>
              </div>
            </div>
          </section>

          <section class="section" id="tab5">
            <div class="section-card">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Education</h2>
                <button type="button" class="btn btn-outline-primary btn-modern" id="addEducationBtn">+ Add Education</button>
              </div>
              <div id="educationContainer"></div>
            </div>
          </section>

          <section class="section" id="tab6">
            <div class="section-card">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Experience</h2>
                <button type="button" class="btn btn-outline-primary btn-modern" id="addExperienceBtn">+ Add Experience</button>
              </div>
              <div id="experienceContainer"></div>
            </div>
          </section>

          <section class="section" id="tab7">
            <div class="section-card">
              <h2 class="section-title">Certificates</h2>
              <div class="row g-3">
                <div class="col-md-4"><label class="form-label">Certificate Name *</label><input required type="text" class="form-control"></div>
                <div class="col-md-4"><label class="form-label">Issued By *</label><input required type="text" class="form-control"></div>
                <div class="col-md-4"><label class="form-label">Upload File *</label><input required type="file" class="form-control"></div>
              </div>
            </div>
          </section>

          <section class="section" id="tab8">
            <div class="section-card">
              <h2 class="section-title">Portfolio</h2>
              <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Website URL</label><input type="url" class="form-control" placeholder="https://"></div>
                <div class="col-md-6"><label class="form-label">GitHub URL</label><input type="url" class="form-control" placeholder="https://github.com/username"></div>
                <div class="col-md-6"><label class="form-label">LinkedIn URL</label><input type="url" class="form-control" placeholder="https://linkedin.com/in/username"></div>
                <div class="col-md-6"><label class="form-label">Other Links</label><input type="url" class="form-control" placeholder="https://"></div>
              </div>
            </div>
          </section>
        </form>
      </main>
    </div>
  </div>

  <div class="sticky-actions">
    <div class="inner">
      <button class="btn btn-outline-secondary btn-modern" type="button">Save Draft</button>
      <button class="btn btn-outline-primary btn-modern" type="button" id="prevBtn">Previous</button>
      <button class="btn btn-primary btn-modern" type="button" id="nextBtn">Next</button>
      <button class="btn btn-success btn-modern" type="button" id="submitBtn">Submit Profile</button>
    </div>
  </div>

  <script>
    const tabs = ["tab1", "tab2", "tab3", "tab4", "tab5", "tab6", "tab7", "tab8"];
    const tabButtons = document.querySelectorAll(".tab-btn");
    let currentTabIndex = 0;

    function openTab(event, tabName) {
      tabs.forEach(tab => document.getElementById(tab).classList.remove("active"));
      document.getElementById(tabName).classList.add("active");
      tabButtons.forEach(btn => btn.classList.remove("active"));
      if (event && event.currentTarget) event.currentTarget.classList.add("active");
      else tabButtons[tabs.indexOf(tabName)].classList.add("active");
      currentTabIndex = tabs.indexOf(tabName);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.getElementById("prevBtn").addEventListener("click", () => {
      if (currentTabIndex > 0) openTab(null, tabs[currentTabIndex - 1]);
    });

    document.getElementById("nextBtn").addEventListener("click", () => {
      if (currentTabIndex < tabs.length - 1) openTab(null, tabs[currentTabIndex + 1]);
    });

    // Profile photo preview
    document.getElementById("profilePhoto").addEventListener("change", function (e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => document.getElementById("avatarPreview").src = ev.target.result;
      reader.readAsDataURL(file);
    });

    // Skill chips
    const skillInput = document.getElementById("skillInput");
    const skillsContainer = document.getElementById("skillsContainer");
    const skillsRequired = document.getElementById("skillsRequired");

    function syncSkillRequired() {
      skillsRequired.value = skillsContainer.querySelectorAll('.chip').length ? 'ok' : '';
    }

    function addSkill() {
      const value = skillInput.value.trim();
      if (!value) return;
      const exists = [...skillsContainer.querySelectorAll('.chip span')].some(el => el.textContent.toLowerCase() === value.toLowerCase());
      if (exists) {
        skillInput.value = '';
        return;
      }
      const chip = document.createElement('div');
      chip.className = 'chip';
      chip.innerHTML = `<span>${value}</span><button type="button" aria-label="Remove skill">&times;</button>`;
      chip.querySelector('button').addEventListener('click', () => {
        chip.remove();
        syncSkillRequired();
      });
      skillsContainer.appendChild(chip);
      skillInput.value = '';
      syncSkillRequired();
    }

    document.getElementById("addSkillBtn").addEventListener("click", addSkill);
    skillInput.addEventListener("keydown", e => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addSkill();
      }
    });

    // Dynamic Education
    const educationContainer = document.getElementById('educationContainer');
    document.getElementById('addEducationBtn').addEventListener('click', () => {
      const block = document.createElement('div');
      block.className = 'repeat-card';
      block.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-2"><strong>Education Details</strong><button type="button" class="btn btn-sm btn-outline-danger remove-btn">Remove</button></div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Degree *</label><input required type="text" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">University *</label><input required type="text" class="form-control"></div>
          <div class="col-md-4"><label class="form-label">Start Year *</label><input required type="number" class="form-control" min="1950" max="2100"></div>
          <div class="col-md-4"><label class="form-label">End Year *</label><input required type="number" class="form-control" min="1950" max="2100"></div>
          <div class="col-md-4"><label class="form-label">Grade *</label><input required type="text" class="form-control"></div>
        </div>`;
      block.querySelector('.remove-btn').addEventListener('click', () => block.remove());
      educationContainer.appendChild(block);
    });

    // Dynamic Experience
    const experienceContainer = document.getElementById('experienceContainer');
    document.getElementById('addExperienceBtn').addEventListener('click', () => {
      const id = `currentWork_${Date.now()}`;
      const block = document.createElement('div');
      block.className = 'repeat-card';
      block.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-2"><strong>Experience Details</strong><button type="button" class="btn btn-sm btn-outline-danger remove-btn">Remove</button></div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Company *</label><input required type="text" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Designation *</label><input required type="text" class="form-control"></div>
          <div class="col-md-4"><label class="form-label">Start Date *</label><input required type="date" class="form-control"></div>
          <div class="col-md-4"><label class="form-label">End Date</label><input type="date" class="form-control end-date"></div>
          <div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input current-working" type="checkbox" id="${id}"><label class="form-check-label" for="${id}">Current Working</label></div></div>
          <div class="col-12"><label class="form-label">Responsibilities *</label><textarea required class="form-control" rows="3"></textarea></div>
        </div>`;
      const currentCheck = block.querySelector('.current-working');
      const endDate = block.querySelector('.end-date');
      currentCheck.addEventListener('change', () => {
        endDate.disabled = currentCheck.checked;
        if (currentCheck.checked) endDate.value = '';
      });
      block.querySelector('.remove-btn').addEventListener('click', () => block.remove());
      experienceContainer.appendChild(block);
    });

    // initialize one default repeat card
    document.getElementById('addEducationBtn').click();
    document.getElementById('addExperienceBtn').click();

    // Form validation
    document.getElementById('submitBtn').addEventListener('click', () => {
      syncSkillRequired();
      const form = document.getElementById('profileForm');
      if (!form.checkValidity()) {
        form.classList.add('was-validated');
        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          const section = firstInvalid.closest('.section');
          if (section) openTab(null, section.id);
          firstInvalid.focus();
        }
        return;
      }
      alert('Profile submitted successfully!');
    });
  </script>
</body>
</html>
